{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Treasury",
  "identifier": "io.github.sepehrmohseni.treasury",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": { "script": "trunk serve --port 1420", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "trunk build --release --locked --cargo-profile wasm-release", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Treasury",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzQkRBMDk4REFBMEE5OUEKUldTYXFhRGFtS0M5ZytaRTVXT1RzQmRTa0dYRmQ2VGVWRzhRWE1nRkhaNEo5V1VHL3ZFbWFUWUsK",
      "endpoints": ["https://github.com/sepehrmohseni/treasury/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A database client that reads your SQL before the server does",
    "copyright": "The Treasury Authors",
    "licenseFile": "../../LICENSE-MIT",
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
